{
  "id": "spec",
  "version": "0.14.0",
  "inputSchema": {
    "type": "object",
    "required": ["taskName"],
    "properties": {
      "taskName": { "type": "string" },
      "scope": { "type": "string" }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["specPath", "tasksPath", "checklistPath"],
    "properties": {
      "specPath": { "type": "string" },
      "tasksPath": { "type": "string" },
      "checklistPath": { "type": "string" },
      "goal": { "type": "string" }
    }
  },
  "requiredTools": ["file-reader", "delegate-agent"]
}
